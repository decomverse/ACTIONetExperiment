# The C++ standard is declared here, not injected through PKG_CXXFLAGS, so that
# R and RcppArmadillo agree on it.
CXX_STD = CXX17

OBJECTS = RcppExports.o RCpp_util.o

# Optimisation level is left to R's own Makeconf: packages that hardcode -O3 and
# a list of -f flags override the user's configuration and are rejected by CRAN.
# -m64 is likewise dropped, as it does not exist on aarch64 (Apple silicon,
# ARM Linux) and made the package unbuildable there.
PKG_CPPFLAGS = -I../inst/include -DARMA_64BIT_WORD
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS     = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS)
