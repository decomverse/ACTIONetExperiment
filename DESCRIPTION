Package: ACTIONetExperiment
Type: Package
Title: ACTIONetExperiment container object
Version: 1.0.3
Date: 2022-12-21
Authors@R: c(
    person("Shahin", "Mohammadi", email = "shahin.mohammadi@gmail.com", role = c("cre", "aut"), comment = c(ORCID = "0000-0001-8734-2326")),
    person("Sebastian", "Pineda", email = "sebastianpineda95@gmail.com", role = "aut", comment = c(ORCID = "0000-0002-8903-0550"))
